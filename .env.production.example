# Production env for docker-compose.prod.yml — copy to `.env.production` on
# the server, fill in real values, never commit the filled-in file. Also
# used directly by `docker compose -f docker-compose.prod.yml`'s variable
# substitution (${...} in that file), not just by the api container.

# --- PostgreSQL ---
POSTGRES_USER=florie
POSTGRES_PASSWORD=CHANGE_ME_use_a_real_random_password
POSTGRES_DB=florie

# --- MinIO ---
MINIO_ROOT_USER=florie_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_use_a_real_random_password
MINIO_BUCKET=florie-media
# Public URL customers'/admins' browsers load images from — the media
# subdomain in nginx/florie.conf, fronting the minio container over HTTPS.
MINIO_PUBLIC_URL=https://media.florie.vn

# --- API (apps/api) ---
NODE_ENV=production
PORT=4000
# Comma-separated if you ever serve multiple frontends off one API.
CORS_ORIGIN=https://florie.vn

# JWT — generate real secrets with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Admin/Staff and Customer use DIFFERENT secrets on purpose — see
# apps/api/src/customer-auth (two fully separate identity domains).
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=florie_refresh_token

JWT_CUSTOMER_ACCESS_SECRET=CHANGE_ME
JWT_CUSTOMER_ACCESS_EXPIRES_IN=30m
JWT_CUSTOMER_REFRESH_EXPIRES_IN_DAYS=30

# Google Sign-In — same client ID as dev works if http(s)://florie.vn is
# added to the OAuth client's Authorized JavaScript origins in Google Cloud
# Console. No client secret needed (ID-token flow only).
GOOGLE_CLIENT_ID=

# AI Module — leave blank to disable (returns a clean 503, doesn't crash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Web (apps/web) — these are build ARGs (docker-compose.prod.yml passes
# them through), because NEXT_PUBLIC_* values are inlined into the browser
# bundle at build time. Changing them requires rebuilding the web image,
# not just restarting the container. ---
NEXT_PUBLIC_API_URL=https://florie.vn
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=https://florie.vn
# Hostname only (no protocol) — added to next.config.ts's image
# remotePatterns so the Next.js image optimizer is allowed to fetch from it.
MEDIA_PUBLIC_HOSTNAME=media.florie.vn
