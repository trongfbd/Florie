generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum TagType {
  OCCASION // Dịp: sinh nhật, khai trương, valentine...
  GENERAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum BannerPosition {
  HOME
  CATEGORY
  PRODUCT
  CHECKOUT
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum MaterialType {
  FLOWER // Hoa
  PAPER // Giấy
  RIBBON // Ruy băng
  FOAM // Mút
  BASKET // Giỏ
  ARRANGEMENT_BOX // Lẵng
  CARD // Thiệp
  CHOCOLATE
  TEDDY_BEAR // Gấu bông
  SCENTED_CANDLE // Nến thơm
  OTHER
}

enum OrderStatus {
  NEW // Đơn mới
  CONFIRMED // Đã xác nhận
  ARRANGING // Đang cắm hoa
  SHIPPING // Đang giao
  COMPLETED // Hoàn thành
  CANCELLED // Đã hủy
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderSource {
  DIRECT
  FACEBOOK
  TIKTOK
  GOOGLE
  OTHER
}

enum ExpenseCategory {
  FACEBOOK_ADS
  TIKTOK_ADS
  GOOGLE_ADS
  STOCK_PURCHASE // Nhập hàng
  ELECTRICITY
  WATER
  INTERNET
  SHIPPING
  SALARY
  OTHER
}

enum NotificationType {
  NEW_ORDER
  LOW_STOCK
  NEW_CUSTOMER
  SYSTEM_ERROR
}

// ============================================================
// AUTH (Admin / Staff accounts)
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  customerNotes   CustomerNote[]
  expenses        Expense[]
  orderStatusLogs OrderStatusHistory[]
  ordersCreated   Order[]
  blogs           Blog[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// CUSTOMERS (storefront accounts / CRM)
// ============================================================

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String   @unique
  passwordHash String?
  totalSpent   Int      @default(0) // VND, kept in sync when an order completes
  isVip        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     CustomerAddress[]
  notes         CustomerNote[]
  orders        Order[]
  wishlistItems WishlistItem[]
  reviews       ProductReview[]

  @@index([isVip])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  addressLine   String
  ward          String?
  district      String?
  province      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ============================================================
// CATALOG (Danh mục / Sản phẩm)
// ============================================================

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  imageUrl       String?
  parentId       String?
  parent         Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryToParent")
  seoTitle       String?
  seoDescription String?
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive])
}

model Tag {
  id   String  @id @default(cuid())
  name String
  slug String  @unique
  type TagType @default(GENERAL)

  products ProductTag[]

  @@index([type])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String?
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  basePrice      Int
  salePrice      Int?
  color          String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  status         ProductStatus @default(DRAFT)
  viewCount      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images         ProductImage[]
  tags           ProductTag[]
  materials      ProductMaterial[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  wishlistItems  WishlistItem[]
  comboItems     ComboItem[]
  flashSaleItems FlashSaleItem[]

  relatedTo   ProductRelation[] @relation("ProductRelations")
  relatedFrom ProductRelation[] @relation("RelatedProducts")

  @@index([categoryId])
  @@index([status])
  @@index([name])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  storageKey   String? // object key in MinIO/S3, used to delete the underlying file
  altText      String?
  displayOrder Int     @default(0)

  @@index([productId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model ProductRelation {
  productId        String
  relatedProductId String
  product          Product @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([customerId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ============================================================
// MARKETING (Combo / Voucher / Flash Sale / Banner / Blog)
// ============================================================

model Combo {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  price       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      ComboItem[]
  orderItems OrderItem[]

  @@index([isActive])
}

model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@index([comboId])
}

model Voucher {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Int
  minOrderValue     Int          @default(0)
  maxDiscountAmount Int?
  usageLimit        Int?
  usedCount         Int          @default(0)
  startAt           DateTime
  endAt             DateTime
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  orders Order[]

  @@index([isActive])
}

model FlashSale {
  id        String   @id @default(cuid())
  name      String
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items FlashSaleItem[]

  @@index([startAt, endAt])
}

model FlashSaleItem {
  id            String    @id @default(cuid())
  flashSaleId   String
  flashSale     FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  salePrice     Int
  quantityLimit Int?
  soldQuantity  Int       @default(0)

  @@unique([flashSaleId, productId])
  @@index([flashSaleId])
}

model Banner {
  id           String         @id @default(cuid())
  title        String
  imageUrl     String
  linkUrl      String?
  position     BannerPosition @default(HOME)
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime       @default(now())

  @@index([position, isActive])
}

model Blog {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  content        String
  thumbnailUrl   String?
  seoTitle       String?
  seoDescription String?
  status         BlogStatus @default(DRAFT)
  authorId       String
  author         User       @relation(fields: [authorId], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([authorId])
}

// ============================================================
// INVENTORY (Kho / Vật tư / BOM)
// ============================================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  materials  Material[]
  importLogs MaterialImportLog[]
}

model Material {
  id                String       @id @default(cuid())
  name              String
  type              MaterialType
  unit              String // đơn vị: bó, cuộn, cái, mét...
  stockQuantity     Decimal      @default(0) @db.Decimal(10, 2)
  minStockThreshold Decimal      @default(0) @db.Decimal(10, 2)
  latestCostPrice   Int          @default(0)
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  importLogs MaterialImportLog[]
  products   ProductMaterial[]

  @@index([type])
  @@index([supplierId])
}

model MaterialImportLog {
  id         String    @id @default(cuid())
  materialId String
  material   Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  quantity   Decimal   @db.Decimal(10, 2)
  unitCost   Int
  importDate DateTime  @default(now())
  note       String?

  @@index([materialId])
}

model ProductMaterial {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal  @db.Decimal(10, 2)

  @@unique([productId, materialId])
  @@index([materialId])
}

// ============================================================
// ORDERS (Đơn hàng)
// ============================================================

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  guestName       String?
  guestPhone      String?
  recipientName   String
  recipientPhone  String
  deliveryAddress String
  deliveryDate    DateTime
  deliveryTime    String?
  cardMessage     String?
  note            String?
  status          OrderStatus   @default(NEW)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Int
  shippingFee     Int           @default(0)
  discountAmount  Int           @default(0)
  total           Int
  voucherId       String?
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  source          OrderSource   @default(DIRECT)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  stockDeductedAt DateTime? // set once, on transition into ARRANGING; used to gate restock-on-cancel
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       ProductReview[]

  @@index([status])
  @@index([customerId])
  @@index([deliveryDate])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  comboId   String?
  combo     Combo?   @relation(fields: [comboId], references: [id])
  itemName  String // snapshot at time of order
  quantity  Int
  unitPrice Int // snapshot at time of order
  subtotal  Int

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id])
  note        String?
  changedAt   DateTime     @default(now())

  @@index([orderId])
}

// ============================================================
// CONTACT (Liên hệ)
// ============================================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled])
}

// ============================================================
// FINANCE (Chi phí)
// ============================================================

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String?
  amount      Int
  expenseDate DateTime        @default(now())
  note        String?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([category])
  @@index([expenseDate])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id              String           @id @default(cuid())
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  relatedEntityId String?
  createdAt       DateTime         @default(now())

  @@index([isRead])
  @@index([type])
}
