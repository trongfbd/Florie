# --- PostgreSQL (used by docker-compose.yml and apps/api) ---
# Host port is 5433, not the default 5432, because this machine already
# has a native PostgreSQL service bound to 5432.
POSTGRES_USER=florie
POSTGRES_PASSWORD=florie_dev_password
POSTGRES_DB=florie
POSTGRES_PORT=5433

# --- MinIO (used by docker-compose.yml and apps/api) ---
MINIO_ROOT_USER=florie_admin
MINIO_ROOT_PASSWORD=florie_dev_password
MINIO_BUCKET=florie-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- API (apps/api) ---
DATABASE_URL=postgresql://florie:florie_dev_password@localhost:5433/florie?schema=public
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT — generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Admin/Staff (apps/api/src/auth) and Customer (apps/api/src/customer-auth)
# use DIFFERENT secrets on purpose — the two identity domains must never
# share a token store or be verifiable against each other's guard.
JWT_ACCESS_SECRET=dev_only_access_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=florie_refresh_token

JWT_CUSTOMER_ACCESS_SECRET=dev_only_customer_access_secret_change_me
JWT_CUSTOMER_ACCESS_EXPIRES_IN=30m
JWT_CUSTOMER_REFRESH_EXPIRES_IN_DAYS=30

# Google Sign-In (customer login only) — create at
# https://console.cloud.google.com/apis/credentials → "Create Credentials"
# → "OAuth client ID" → Application type "Web application". Add
# http://localhost:3000 under "Authorized JavaScript origins" (no redirect
# URI needed — this app uses the ID-token flow, not the redirect flow).
# The SAME client ID goes in both API and Web; there is no client secret
# needed for this flow.
GOOGLE_CLIENT_ID=

# MinIO client config (apps/api talks to the container from the host during dev)
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# AI Module (Sprint 11) — get a free key at https://aistudio.google.com/apikey,
# no billing required to start. Leave blank to run without AI features (each
# endpoint returns a clear 503 instead of crashing, same pattern as
# GOOGLE_CLIENT_ID above).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Used for sitemap.xml/robots.txt absolute URLs and Open Graph metadataBase —
# set to the real production domain (e.g. https://florie.vn) when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
